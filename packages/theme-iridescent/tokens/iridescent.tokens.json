{
  "$schema": "https://schemas.tokens.studio/2025.10/dtcg-schema.json",
  "$metadata": { "name": "Wildfire × Iridescent", "version": "1.0.0" },
  "material": {
    "ior-film":          { "$type": "number", "$value": 1.35, "$description": "uN2 — nacre film IOR" },
    "ior-substrate":     { "$type": "number", "$value": 1.50, "$description": "uN3 — substrate IOR" },
    "film-thickness-min":{ "$type": "number", "$value": 0.3,  "$description": "uFilmThickness idle" },
    "film-thickness-max":{ "$type": "number", "$value": 0.92, "$description": "uFilmThickness peak" },
    "base-color-r":      { "$type": "number", "$value": 0.04, "$description": "uBaseColor.r" },
    "base-color-g":      { "$type": "number", "$value": 0.02, "$description": "uBaseColor.g" },
    "base-color-b":      { "$type": "number", "$value": 0.09, "$description": "uBaseColor.b" }
  },
  "motion": {
    "tilt-strength":              { "$type": "number", "$value": 12,   "$description": "TiltedChromaCard max tilt degrees" },
    "spring-stiffness-ui":        { "$type": "number", "$value": 200,  "$description": "Spring stiffness for tilt" },
    "spring-damping-ui":          { "$type": "number", "$value": 22,   "$description": "Spring damping for tilt" },
    "spring-stiffness-chroma":    { "$type": "number", "$value": 160,  "$description": "Spring stiffness for scroll chroma" },
    "spring-damping-chroma":      { "$type": "number", "$value": 24,   "$description": "Spring damping for scroll chroma" },
    "spring-stiffness-thickness": { "$type": "number", "$value": 220,  "$description": "Spring stiffness for film thickness" },
    "spring-damping-thickness":   { "$type": "number", "$value": 26,   "$description": "Spring damping for film thickness" },
    "velocity-range":             { "$type": "number", "$value": 1200, "$description": "px/s for full dispersion" },
    "aberration-lerp-dispersion": { "$type": "number", "$value": 0.12, "$description": "Per-frame dispersion lerp factor" },
    "aberration-lerp-angle":      { "$type": "number", "$value": 0.08, "$description": "Per-frame angle lerp factor" }
  },
  "cursor": {
    "iris-radius":         { "$type": "number", "$value": 0.045, "$description": "uRadius outer iris ring" },
    "pupil-radius":        { "$type": "number", "$value": 0.014, "$description": "uPupilRadius inner" },
    "velocity-decay":      { "$type": "number", "$value": 0.88,  "$description": "Per-frame velocity decay on release" },
    "glow-velocity-scale": { "$type": "number", "$value": 0.55,  "$description": "Outer glow intensity multiplier" }
  },
  "surface": {
    "card-background":  { "$type": "color",     "$value": "#0f0e1f", "$description": "DOM card background" },
    "page-background":  { "$type": "color",     "$value": "#080a0f", "$description": "Root page background" },
    "text-primary":     { "$type": "color",     "$value": "#e8e0ff", "$description": "Primary text" },
    "text-muted":       { "$type": "color",     "$value": "#a09ec0", "$description": "Muted labels" },
    "card-radius":      { "$type": "dimension", "$value": "16px",   "$description": "Card border radius" },
    "card-perspective": { "$type": "number",    "$value": 800,      "$description": "CSS perspective px" }
  }
}

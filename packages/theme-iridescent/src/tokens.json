{
  "$schema": "https://design-tokens.github.io/json-schema/draft-01/schema.json",
  "color": {
    "surface":     { "$value": "#050510", "$type": "color" },
    "prismA":      { "$value": "#c084fc", "$type": "color" },
    "prismB":      { "$value": "#38bdf8", "$type": "color" },
    "abaloneBase": { "$value": "#e2e8f0", "$type": "color" }
  },
  "motion": {
    "durationMicro": { "$value": 200, "$type": "duration" },
    "durationMacro": { "$value": 500, "$type": "duration" },
    "easeSpring": {
      "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "$type": "cubicBezier"
    },
    "easeOutExpo": {
      "$value": "cubic-bezier(0.16, 1, 0.3, 1)",
      "$type": "cubicBezier"
    }
  },
  "shader": {
    "aberrationStrength": { "$value": 0.018, "$type": "number" },
    "filmThickness":      { "$value": 0.72,  "$type": "number" },
    "refractionIOR":      { "$value": 1.45,  "$type": "number" },
    "animationSpeed":     { "$value": 0.6,   "$type": "number" },
    "dispersionSpread":   { "$value": 2.4,   "$type": "number" }
  },
  "spacing": {
    "cardGap":    { "$value": "16px", "$type": "dimension" },
    "cardRadius": { "$value": "12px", "$type": "dimension" }
  },
  "elevation": {
    "card": {
      "$value": "0 8px 32px rgba(0,0,0,0.45)",
      "$type": "shadow"
    }
  }
}
